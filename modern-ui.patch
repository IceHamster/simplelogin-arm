index f920a9d3..2e4b09f3 100644
--- a/server.py
+++ b/server.py
@@ -127,6 +127,7 @@ def create_app() -> Flask:
     app.secret_key = FLASK_SECRET
 
     app.config["TEMPLATES_AUTO_RELOAD"] = True
+    app.config["VITE_DEV"] = os.getenv("VITE_DEV", "false").lower() == "true"
 
     # to have a "fluid" layout for admin
     app.config["FLASK_ADMIN_FLUID_LAYOUT"] = True
@@ -415,6 +416,34 @@ def jinja2_filter(app):
             HEADER_ALLOW_API_COOKIES=constants.HEADER_ALLOW_API_COOKIES,
         )
 
+    @app.context_processor
+    def vite_helpers():
+        def vite_asset(entrypoint):
+            if app.config.get("VITE_DEV"):
+                return f'<script type="module" src="http://localhost:5173/src/{entrypoint}"></script>'
+            
+            # In production, we should read from manifest.json
+            # For now, let's assume it's pre-built in static/dist
+            # A more robust version would parse static/dist/.vite/manifest.json
+            import json
+            manifest_path = os.path.join(app.root_path, 'static', 'dist', '.vite', 'manifest.json')
+            try:
+                with open(manifest_path, 'r') as f:
+                    manifest = json.load(f)
+                    asset_file = manifest.get(f"src/{entrypoint}")['file']
+                    css_files = manifest.get(f"src/{entrypoint}").get('css', [])
+                    
+                    html = ""
+                    for css in css_files:
+                        html += f'<link rel="stylesheet" href="/static/dist/{css}">'
+                    html += f'<script type="module" src="/static/dist/{asset_file}"></script>'
+                    return html
+            except Exception as e:
+                LOG.e(f"Error loading vite manifest: {e}")
+                return ""
+
+        return dict(vite_asset=vite_asset)
+
 
 def init_extensions(app: Flask):
     login_manager.init_app(app)
