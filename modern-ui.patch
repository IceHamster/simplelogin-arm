diff --git a/templates/partials/onboarding_modal.html b/templates/partials/onboarding_modal.html
new file mode 100644
index 00000000..fdd906d4
--- /dev/null
+++ b/templates/partials/onboarding_modal.html
@@ -0,0 +1,117 @@
+<!-- Modern Onboarding Modal Component -->
+{% if show_intro %}
+<div id="onboarding-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-gray-900/60 backdrop-blur-sm transition-opacity duration-300">
+  <div class="bg-white dark:bg-gray-900 w-full max-w-lg mx-4 rounded-2xl shadow-2xl overflow-hidden transform transition-all scale-100 opacity-100" id="onboarding-content">
+    
+    <!-- Header -->
+    <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-800 flex items-center justify-between">
+      <div class="flex items-center space-x-2">
+        <div class="p-1.5 bg-indigo-50 dark:bg-indigo-900/30 rounded-lg">
+          <i class="fe fe-zap text-indigo-600 dark:text-indigo-400"></i>
+        </div>
+        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Welcome to SimpleLogin</h3>
+      </div>
+      <button onclick="closeOnboarding()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors">
+        <i class="fe fe-x text-xl"></i>
+      </button>
+    </div>
+
+    <!-- Steps Container -->
+    <div class="relative min-h-[300px]">
+      <!-- Step 1: Aliases -->
+      <div id="onboarding-step-1" class="absolute inset-0 p-8 flex flex-col justify-center transition-all duration-300 transform translate-x-0 opacity-100">
+        <div class="w-16 h-16 bg-blue-50 dark:bg-blue-900/20 rounded-2xl flex items-center justify-center mb-6 mx-auto">
+          <i class="fe fe-shield text-3xl text-blue-600 dark:text-blue-400"></i>
+        </div>
+        <h4 class="text-xl font-bold text-center text-gray-900 dark:text-white mb-2">Protect your inbox</h4>
+        <p class="text-sm text-center text-gray-500 dark:text-gray-400 leading-relaxed max-w-sm mx-auto">
+          Create unique <strong>aliases</strong> for every website you use. Emails sent to an alias are instantly forwarded to your real inbox.
+        </p>
+      </div>
+
+      <!-- Step 2: Sending -->
+      <div id="onboarding-step-2" class="absolute inset-0 p-8 flex flex-col justify-center transition-all duration-300 transform translate-x-full opacity-0 pointer-events-none">
+        <div class="w-16 h-16 bg-green-50 dark:bg-green-900/20 rounded-2xl flex items-center justify-center mb-6 mx-auto">
+          <i class="fe fe-send text-3xl text-green-600 dark:text-green-400"></i>
+        </div>
+        <h4 class="text-xl font-bold text-center text-gray-900 dark:text-white mb-2">Reply anonymously</h4>
+        <p class="text-sm text-center text-gray-500 dark:text-gray-400 leading-relaxed max-w-sm mx-auto">
+          When you reply to a forwarded email, the response comes from your alias. Your real email address remains hidden.
+        </p>
+      </div>
+
+      <!-- Step 3: Extensions -->
+      <div id="onboarding-step-3" class="absolute inset-0 p-8 flex flex-col justify-center transition-all duration-300 transform translate-x-full opacity-0 pointer-events-none">
+        <div class="w-16 h-16 bg-amber-50 dark:bg-amber-900/20 rounded-2xl flex items-center justify-center mb-6 mx-auto">
+          <i class="fe fe-chrome text-3xl text-amber-600 dark:text-amber-400"></i>
+        </div>
+        <h4 class="text-xl font-bold text-center text-gray-900 dark:text-white mb-2">Get the extension</h4>
+        <p class="text-sm text-center text-gray-500 dark:text-gray-400 leading-relaxed max-w-sm mx-auto">
+          For the best experience, install our browser extension. You can generate aliases directly inside email fields with one click.
+        </p>
+      </div>
+    </div>
+
+    <!-- Footer / Navigation -->
+    <div class="px-6 py-4 bg-gray-50 dark:bg-gray-800/50 border-t border-gray-100 dark:border-gray-800 flex items-center justify-between">
+      <div class="flex space-x-2" id="onboarding-dots">
+        <span class="w-2 h-2 rounded-full bg-indigo-600 transition-colors"></span>
+        <span class="w-2 h-2 rounded-full bg-gray-300 dark:bg-gray-600 transition-colors"></span>
+        <span class="w-2 h-2 rounded-full bg-gray-300 dark:bg-gray-600 transition-colors"></span>
+      </div>
+      
+      <div class="flex space-x-3">
+        <button onclick="closeOnboarding()" class="px-4 py-2 text-sm font-semibold text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">Skip</button>
+        <button onclick="nextOnboardingStep()" id="onboarding-next-btn" class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold rounded-xl shadow-sm transition-all">Next</button>
+      </div>
+    </div>
+  </div>
+</div>
+
+<script>
+  let currentStep = 1;
+  const totalSteps = 3;
+
+  function updateOnboardingUI() {
+    // Update steps visibility
+    for (let i = 1; i <= totalSteps; i++) {
+      const step = document.getElementById(`onboarding-step-${i}`);
+      if (i === currentStep) {
+        step.className = 'absolute inset-0 p-8 flex flex-col justify-center transition-all duration-300 transform translate-x-0 opacity-100 z-10';
+      } else if (i < currentStep) {
+        step.className = 'absolute inset-0 p-8 flex flex-col justify-center transition-all duration-300 transform -translate-x-full opacity-0 pointer-events-none';
+      } else {
+        step.className = 'absolute inset-0 p-8 flex flex-col justify-center transition-all duration-300 transform translate-x-full opacity-0 pointer-events-none';
+      }
+    }
+
+    // Update dots
+    const dots = document.getElementById('onboarding-dots').children;
+    for (let i = 0; i < dots.length; i++) {
+      dots[i].className = `w-2 h-2 rounded-full transition-colors ${i + 1 === currentStep ? 'bg-indigo-600' : 'bg-gray-300 dark:bg-gray-600'}`;
+    }
+
+    // Update button text
+    const nextBtn = document.getElementById('onboarding-next-btn');
+    nextBtn.innerText = currentStep === totalSteps ? 'Get Started' : 'Next';
+  }
+
+  function nextOnboardingStep() {
+    if (currentStep < totalSteps) {
+      currentStep++;
+      updateOnboardingUI();
+    } else {
+      closeOnboarding();
+    }
+  }
+
+  function closeOnboarding() {
+    const modal = document.getElementById('onboarding-modal');
+    modal.classList.add('opacity-0');
+    setTimeout(() => {
+      modal.style.display = 'none';
+      // Here you could make an API call to mark onboarding as complete
+    }, 300);
+  }
+</script>
+{% endif %}
