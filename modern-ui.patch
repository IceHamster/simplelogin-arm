diff --git a/static/src/main.js b/static/src/main.js
new file mode 100644
index 00000000..d18fd364
--- /dev/null
+++ b/static/src/main.js
@@ -0,0 +1,36 @@
+import './style.css';
+
+console.log('SimpleLogin modern frontend initialized');
+
+// Synchronize dark mode with SimpleLogin's cookie-based theme
+function syncDarkMode() {
+  const isDarkMode = document.documentElement.getAttribute('data-theme') === 'dark' || 
+                    document.cookie.includes('dark-mode=true');
+  
+  if (isDarkMode) {
+    document.documentElement.classList.add('dark');
+  } else {
+    document.documentElement.classList.remove('dark');
+  }
+}
+
+// Watch for changes to data-theme attribute
+const observer = new MutationObserver((mutations) => {
+  mutations.forEach((mutation) => {
+    if (mutation.attributeName === 'data-theme') {
+      syncDarkMode();
+    }
+  });
+});
+
+observer.observe(document.documentElement, { attributes: true });
+
+// Initial sync
+syncDarkMode();
+
+// Listen for dark mode toggle clicks
+document.addEventListener('click', (e) => {
+  if (e.target.closest('[data-toggle="dark-mode"]')) {
+    setTimeout(syncDarkMode, 50); // Small delay to allow cookie update
+  }
+});
