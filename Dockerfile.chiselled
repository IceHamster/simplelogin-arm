# syntax=docker/dockerfile:1
ARG UV_VERSION=0.7.13
ARG CHISEL_VERSION=1.3.0

# -----------------------------------------------------------------------------
# Stage 1: Build frontend assets
# -----------------------------------------------------------------------------
FROM node:10.17.0-alpine AS npm
WORKDIR /code
COPY ./static/package*.json /code/static/
RUN cd /code/static && npm ci

# -----------------------------------------------------------------------------
# Stage 2: Fetch uv
# -----------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv_source

# -----------------------------------------------------------------------------
# Stage 3: Builder & Chiseler
# -----------------------------------------------------------------------------
FROM ubuntu:24.04 AS builder
ARG CHISEL_VERSION

# 1. Configure uv to use the system python explicitly
# This prevents it from downloading a managed version
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/bin/python3.12 \
    CMAKE_POLICY_VERSION_MINIMUM=3.5

WORKDIR /code

# 2. Install Dependencies (including Python 3.12 for the builder)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        python3 \
        python3-dev \
        pkg-config \
        cmake \
        ninja-build \
        clang \
        gcc \
        libre2-dev \
        git \
        ca-certificates \
        curl \
        gnupg \
    && \
    curl -sL https://github.com/canonical/chisel/releases/download/v${CHISEL_VERSION}/chisel_v${CHISEL_VERSION}_linux_amd64.tar.gz | tar xz -C /usr/bin/

COPY --from=uv_source /uv /usr/bin/uv
COPY pyproject.toml uv.lock .python-version ./

# 3. Create venv using System Python
# Since we set UV_PYTHON=/usr/bin/python3.12, the venv symlink 
# will point to /usr/bin/python3.12, which matches the Chisel image.
RUN uv sync --no-dev --no-cache

# 4. Chisel the runtime
WORKDIR /rootfs
RUN chisel cut --release ubuntu-24.04 --root /rootfs \
    base-files_base \
    base-files_release-info \
    python3.12_standard \
    ca-certificates_data \
    openssl_config

# Manually copy libre2 (since you build against it)
RUN find /usr/lib/x86_64-linux-gnu -name "libre2.so*" -exec cp -v {} /rootfs/usr/lib/x86_64-linux-gnu/ \;

# Healthcheck script
RUN echo 'import socket, sys; \
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM); \
result = s.connect_ex(("127.0.0.1", 7777)); \
s.close(); \
sys.exit(0 if result == 0 else 1)' > /rootfs/healthcheck.py

# -----------------------------------------------------------------------------
# Stage 4: Final Chiselled Runtime
# -----------------------------------------------------------------------------
FROM scratch

COPY --from=builder /rootfs /

WORKDIR /code
COPY --from=builder /code/.venv /code/.venv
COPY --from=npm /code /code
COPY . .

# We don't strictly need PYTHONPATH if the venv is healthy, 
# but it's a good safety net in scratch images.
ENV PATH="/code/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

EXPOSE 7777

CMD ["gunicorn", "wsgi:app", "-b", "0.0.0.0:7777", "-w", "2", "--timeout", "15"]